# DigiResult environment configuration
# Copy this file to .env for local/hosted deployment.
# Existing server environment variables take precedence over .env values.

APP_NAME=DigiResult
APP_INSTITUTE=New Horizon Education Society / New Horizon Institute of Technology and Management
APP_ADDRESS=Anand Nagar, Kavesar, Off Ghodbunder Road, Thane (W) - 400615.
APP_ENV=production
APP_BASE_PATH=
APP_DEV_OTP_MODE=false

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

MAIL_MODE=brevo_api
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=DigiResult
REPLY_TO=
TEST_RECIPIENT=
BREVO_TIMEOUT_SECONDS=15

SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_REQUESTS_15M=5
OTP_MAX_ATTEMPTS=5
ADMIN_PASSWORD_RESET_TTL_MINUTES=15
